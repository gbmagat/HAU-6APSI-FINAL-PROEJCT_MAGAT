# Server-only PostgreSQL connection for Our Places. Keep this value private.
# Use a dedicated database and account, separate from other apps on the VPS.
# With no DATABASE_URL, development runs the local browser preview; production
# keeps the private pages locked instead of exposing that preview publicly.
DATABASE_URL=

# Private photo folder, outside public/. Defaults to ./storage/photos.
# On the VPS use a directory owned by the service account, for example /var/lib/our-places/photos.
PHOTO_DIR=

# Saved OpenStreetMap road tiles for routes. Defaults to ./storage/roads and can be deleted at any time.
# On the VPS, for example /var/cache/our-places/roads.
ROAD_CACHE_DIR=

# Plan reminder emails. Without SMTP_HOST, emails are saved to ./storage/outbox instead of being sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address, SMTP_PASS=an app password
# (Google Account > Security > 2-Step Verification > App passwords). Never commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public address of the site, used for links in emails, for example https://ourplaces.example.com
APP_URL=

# The code someone must enter to create a new account and space. Leave empty to keep sign-up closed
# (partner invite links still work). Share it privately; never commit a real value.
SIGNUP_CODE=
